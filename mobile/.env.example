# Copy to .env (or .env.local) — Expo exposes EXPO_PUBLIC_* vars to the app.

# Backend API base URL. Defaults to production if unset.
EXPO_PUBLIC_API_URL=https://api.selai.es

# Local development is the only environment allowed to use X-Dev-Email.
EXPO_PUBLIC_APP_ENV=development

# Clerk publishable key (Dashboard -> API Keys). Use a pk_test_ value locally.
# If unset, a development bundle falls back to the X-Dev-Email login.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sentry DSN (Sentry → Project Settings → Client Keys). If unset, error
# telemetry stays off — see src/lib/sentry.ts. It is also read from
# app.json `extra.sentryDsn` so a store build can't ship without it.
# Never reports in development, with or without a DSN.
EXPO_PUBLIC_SENTRY_DSN=

# EAS project identifiers (set as EAS environment variables for builds/updates).
# Read by app.config.js; not committed in app.json.
EAS_PROJECT_ID=
EXPO_OWNER=
