# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Clave de firma global. Ya no se usa para nuevas credenciales tenant; se debe
# conservar durante la transición para leer sobres legacy enc:v1.
SECRET_KEY=change-me-in-prod
# Genera una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# El valor KEYS es JSON. Para rotar, añade la clave nueva, cambia ACTIVE_KEY_ID,
# despliega todos los lectores y ejecuta app.scripts.rewrap_tenant_credentials.
TENANT_CREDENTIAL_ACTIVE_KEY_ID=
TENANT_CREDENTIAL_KEYS={}
# Primer rolling deploy solamente: usa plaintext + ACK hasta que todos los
# procesos sepan leer v2; cambia después a v2 y vuelve a dejar ACK=false.
TENANT_CREDENTIAL_WRITE_MODE=v2
TENANT_CREDENTIAL_PLAINTEXT_WRITE_ACK=false

# --- Identidad legal global del prestador ---
# Déjalo vacío en desarrollo: la aplicación mostrará etiquetas "pendiente".
# En producción los cinco valores son obligatorios y no pueden ser placeholders.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_VAT=
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_CITY=
LEGAL_DPO_EMAIL=
# Pon true solo cuando asesoria haya revisado Terminos, DPA, Privacidad y orden.
LEGAL_REVIEW_CONFIRMED=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://realtor:realtor@localhost:5432/realtor
REDIS_URL=redis://localhost:6379/0
# Rate limiter storage: auto | memory | redis
RATE_LIMIT_BACKEND=auto

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL_FAST=claude-haiku-4-5-20251001
AGENT_MODEL_SMART=claude-opus-4-7
# Output guardrail: LLM judge on top of the deterministic rules (fail-open).
GUARDRAIL_LLM_ENABLED=true

# --- Voyage embeddings (recommended pairing for Claude) ---
VOYAGE_API_KEY=

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=set-this-to-anything-and-mirror-in-meta-console
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Email (Resend) ---
RESEND_API_KEY=
# Optional read-only key for fetching inbound e-mail bodies (falls back to RESEND_API_KEY).
RESEND_READ_API_KEY=
# Svix signing secret of the Resend inbound webhook (whsec_...). Empty = inbound not wired.
RESEND_WEBHOOK_SECRET=
# Verified sender identity for product e-mail.
# RESEND_FROM="Your Brand <hello@your-verified-domain.example>"
# Sender for the AI's conversational replies. Empty falls back to RESEND_FROM.
EMAIL_FROM=
# Agencies receive portal leads at <slug>-leads@<EMAIL_LEADS_DOMAIN>.
# EMAIL_LEADS_DOMAIN=leads.your-domain.example

# --- Google Calendar (OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- Voice (Vapi) — Sprint 3 ---
# 1. Crea cuenta en vapi.ai y obtén API key.
# 2. Crea un Phone Number en Vapi (importa de Twilio o usa el suyo).
# 3. Crea un Assistant con model.provider=custom-llm,
#    model.url=https://TU_DOMINIO/voice/llm
#    y guarda el assistantId en agency.settings.vapi_assistant_id.
# 4. Configura los webhooks del assistant a https://TU_DOMINIO/webhooks/voice
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# --- Twilio (SMS y telefonía secundaria) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Transcription (Deepgram) — notas de voz + voz tiempo real ---
DEEPGRAM_API_KEY=

# --- File storage ---
# Desarrollo puede usar el filesystem local. Producción exige un bucket S3
# compatible: los contenedores son efímeros y /files no publica datos en prod.
PUBLIC_BASE_URL=http://localhost:8000
LOCAL_STORAGE_ROOT=./data/storage
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT_URL=

# --- Voice cloning (ElevenLabs) — Sprint 4 ---
ELEVENLABS_API_KEY=

# --- Auth (Clerk) — Sprint 4 ---
# Si CLERK_JWKS_URL está vacía y APP_ENV=development, el backend acepta el
# header X-Dev-User como auth dummy. EN PRODUCCIÓN siempre debe estar puesta.
CLERK_JWKS_URL=
# Opcional si CLERK_JWKS_URL es el endpoint genérico de api.clerk.com; con la
# URL JWKS de la instancia se deriva automáticamente del mismo origen.
CLERK_ISSUER=
# Los tokens de sesión estándar de Clerk no incluyen aud. Si lo añades en la
# plantilla/configuración de sesión, fija aquí exactamente el audience esperado.
CLERK_AUDIENCE=
# JSON con los orígenes web autorizados para el claim azp. La app nativa puede
# omitir azp, como documenta Clerk. Para Clerk local añade http://localhost:3000.
CLERK_AUTHORIZED_PARTIES=["https://selai.es","https://www.selai.es"]

# --- Stripe billing — Sprint 5 ---
# Produccion exige una clave live (sk_live_); usa sk_test_ solo en desarrollo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID bpc_ de una configuracion guardada del Customer Portal.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Pon true solo tras validar IVA, tax_behavior/precios y una factura live.
STRIPE_TAX_SETUP_CONFIRMED=false

# --- Idealista Partner API — Sprint 5 ---
IDEALISTA_CLIENT_ID=
IDEALISTA_CLIENT_SECRET=

# --- Observability ---
SENTRY_DSN=
