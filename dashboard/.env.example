# Backend API (server-side only)
BACKEND_URL=http://localhost:8000

# Clerk auth — leave both empty in local dev to use the backend's
# X-Dev-Email trusted-header mode instead of real auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dev-only: identity sent to the backend when Clerk is disabled.
# Must match a seeded user (see backend seed_demo), e.g. owner@piloto.test
DEV_USER_EMAIL=

# Dev-only escape hatch: skip the /me lookup with a fixed agency id.
NEXT_PUBLIC_DEFAULT_AGENCY_ID=

# Public marketing surface
NEXT_PUBLIC_SITE_URL=https://selai.es

# Booking link for "Reservar demo". LEAVE EMPTY unless the Cal.com agenda
# actually exists — empty renders the honest mailto fallback instead.
NEXT_PUBLIC_CALCOM_LINK=

# Public backend origin used by browser-side chat (demo, /probar, wizard,
# /chat/[slug]). CORS on the backend allows selai.es.
NEXT_PUBLIC_PUBLIC_API_URL=https://api.selai.es

# Slug of the seeded demo agency the landing's live demo talks to. Must
# exist in the backend DB (seed_demo_public creates "demo" on boot).
NEXT_PUBLIC_DEMO_AGENCY_SLUG=demo

# Sentry error reporting. LEAVE EMPTY to keep it off: without a DSN the SDK is
# never initialised, so nothing is sent and no request leaves the browser.
# It is also never enabled in development, only in production builds.
# No PII is sent (sendDefaultPii: false) and traces are sampled at 10%.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: the support form tags each report with the deployed commit, read
# from NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA (Vercel injects it when "Automatically
# expose System Environment Variables" is on). Absent → the report says nothing
# about the version instead of guessing.
